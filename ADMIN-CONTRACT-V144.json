{
  "version":"V144",
  "environment":"staging",
  "route":"/admin",
  "ownerOnly":true,
  "authentication":{
    "verifiedEmail":true,
    "mfaRequired":true,
    "secureHttpOnlyCookie":true,
    "recoveryCodes":true,
    "clientSideRoleAccepted":false,
    "stepUpActions":["consultation-price-change","billing-change","publication","secret-change"]
  },
  "endpoints":[
    {"method":"GET","path":"/admin/session","purpose":"verify owner session and MFA"},
    {"method":"POST","path":"/admin/session","purpose":"start owner sign-in"},
    {"method":"POST","path":"/admin/session/mfa","purpose":"verify second factor"},
    {"method":"DELETE","path":"/admin/session","purpose":"revoke current session"},
    {"method":"GET","path":"/admin/overview","purpose":"sanitized operational counters"},
    {"method":"GET","path":"/admin/modules/:moduleId","purpose":"sanitized module data"},
    {"method":"PATCH","path":"/admin/consultations/prices","purpose":"future prices with MFA step-up and immutable historical snapshots"},
    {"method":"GET","path":"/admin/diagnostic","purpose":"authorized sanitized diagnostic"}
  ],
  "modules":["today","finance","users","subscriptions","ai","tarot","school","consultations","store","skins","media","notifications","analytics","seo","security","backups","audit","settings"],
  "privacy":{
    "journalBodies":false,
    "journalQuestions":false,
    "aiPrompts":false,
    "aiResponses":false,
    "consultationQuestions":false,
    "passwords":false,
    "secrets":false,
    "sanitizedAnalyticsOnly":true
  },
  "productionFlags":{
    "production_publish_authorized":false,
    "dns_changes_authorized":false,
    "real_billing_authorized":false,
    "store_submission_authorized":false,
    "ORBE_AI_SOL_ENABLED":false
  }
}
