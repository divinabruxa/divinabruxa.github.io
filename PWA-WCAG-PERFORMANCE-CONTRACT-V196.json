      "INP_ms_max": 200,
      "CLS_max": 0.1,
      "segmentation": ["mobile", "desktop"]
    },
    "measurement": {
      "runtime": "PerformanceObserver",
      "in_memory": true,
      "local_persistence": "only when analytics consent is true",
      "network_transport": false,
      "stored_url": false,
      "stored_account_or_diary": false,
      "maximum_samples_per_metric": 75,
      "field_p75_status": "pending real post-install traffic"
