    {"key": "consultation_owner_new", "category": "consultation", "transactional": true, "marketing": false},
    {"key": "consultation_customer_confirmation", "category": "consultation", "transactional": true, "marketing": false},
    {"key": "security_alert", "category": "security", "transactional": true, "marketing": false},
    {"key": "purchase_receipt", "category": "purchase", "transactional": true, "marketing": false},
    {"key": "refund_confirmation", "category": "refund", "transactional": true, "marketing": false},
    {"key": "support_update", "category": "support", "transactional": true, "marketing": false}
