{
  "project": "Divina Bruxa",
  "version": 198,
  "contains_secret_values": false,
  "environments": ["local", "staging", "production"],
  "separation_required": true,
  "items": [
    {
      "name": "SUPABASE_URL",
      "client_visibility": "public-config",
      "owners": ["frontend", "backend"],
      "separate_per_environment": true
    },
    {
      "name": "SUPABASE_PUBLISHABLE_KEY",
      "client_visibility": "public-by-design-with-RLS",
      "owners": ["frontend"],
      "separate_per_environment": true
    },
    {
      "name": "SUPABASE_SERVER_SECRET",
      "client_visibility": "server-only",
      "owners": ["backend"],
      "separate_per_environment": true
    },
    {
      "name": "STRIPE_SECRET_KEY",
      "client_visibility": "server-only",
      "owners": ["commerce-backend"],
      "separate_per_environment": true
    },
    {
      "name": "STRIPE_WEBHOOK_SECRET",
      "client_visibility": "server-only",
      "owners": ["commerce-webhook"],
      "separate_per_environment": true
    },
    {
      "name": "RESEND_API_KEY",
      "client_visibility": "server-only",
      "owners": ["email-backend"],
      "separate_per_environment": true
    },
    {
      "name": "PLAY_SERVICE_CREDENTIAL",
      "client_visibility": "server-only",
      "owners": ["entitlement-backend"],
      "separate_per_environment": true
    },
    {
      "name": "APP_STORE_SERVER_CREDENTIAL",
      "client_visibility": "server-only",
      "owners": ["entitlement-backend"],
      "separate_per_environment": true
    }
  ],
  "storage_policy": {
    "allowed": ["managed-secret-vault", "protected-ci-secret", "runtime-environment"],
    "forbidden": ["html", "public-javascript", "repository", "zip", "issue", "log", "screenshot"],
    "least_privilege": true,
    "rotation_after_exposure": true,
    "audit_access": true
  }
}

