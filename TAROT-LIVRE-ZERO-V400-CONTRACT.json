    "mobile_columns": 6,
    "smooth_open_close": true
  },
  "rules": {
    "deck_size": 78,
    "no_reversed_cards": true,
    "no_repetition": true,
    "no_meanings": true,
    "grid_columns": 6
  },
  "assets": {
    "new_static_images": false,
    "uses_existing_card_art": true,
    "uses_existing_orb_skin_variables": true
  },
  "production_guards": {
    "production_publish_authorized": false,
    "dns_changes_authorized": false,
    "real_billing_authorized": false,
    "store_submission_authorized": false,
    "ORBE_AI_SOL_ENABLED": false
