{
  "project": "Divina Bruxa 2.0",
  "release": "V400",
  "name": "Tarot Livre Zero — Chama Viva",
  "scope": "Tarot Livre rebuilt from zero; all other worlds preserved.",
  "root_cause_fixed": "The official page loader was still loading free-tarot-world-v301.js/css after the newer fire overlays, so the old Tarot remained authoritative.",
  "replace": [
    "app-v208.js",
    "page-loader-v1.js"
  ],
  "new": [
    "tarot-livre-zero-v400.js",
    "tarot-livre-zero-v400.css",
    "TAROT-LIVRE-ZERO-V400-CONTRACT.json"
  ],
  "engine": {
    "single_world": true,
    "old_v301_loaded": false,
    "old_v345_overlay_loaded": false,
    "living_flame_canvas_2d": true,
    "background_canvas": true,
    "foreground_fire_canvas": true,
    "orb_to_card_ribbons": true,
    "particle_burst_on_reveal": true,
    "card_fire_crown_on_reveal": true,
    "fast_birth_ms": 430,
    "card_kept_visible_while_next_image_prepares": true
  },
  "mesa_real": {
