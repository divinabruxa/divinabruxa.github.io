{
  "release":"V205",
  "name":"Ledger Universal de Direitos",
  "environment":"staging",
  "enabled_provider":"stripe_test",
  "reserved_providers":["google_play_sandbox","apple_store_sandbox"],
  "authority":{
    "grant":"signed_provider_event_or_owner_aal2_only",
    "snapshot":"authenticated_user_bound_rpc",
    "client_write":false,
    "screenshots":false,
    "query_parameters":false,
    "local_storage":false,
    "client_price":false
  },
  "records":["product","order","provider_event","provider_transaction","subscription","entitlement_claim","entitlement_ledger","credit_lot","credit_spend","manual_adjustment","reconciliation"],
  "invariants":{
    "duplicate_credit":0,
    "ghost_entitlement":0,
    "append_only_financial_history":true,
    "per_subject_serialization":true,
    "event_idempotency":true,
    "out_of_order_projection_guard":true,
    "tamper_evident_user_hash_chain":true,
    "refund_preserves_created_content":true,
    "revoked_equipped_skin_falls_back_to_classic":true,
    "negative_available_credit":false,
    "credit_debt_explicit":true
  },
  "subscription_policy":{
    "monthly_credits":400,
    "monthly_credit_expiration":"current_period_end",
    "cancel_at_period_end_keeps_access":true,
    "past_due_freezes_ai":true,
    "inactive_keeps_extra_credits_recorded":true,
    "inactive_blocks_extra_credit_use":true
  },
  "refund_policy":{
    "premium":"revoke_only_source_claims_keep_user_content",
    "skin":"revoke_only_source_claim_and_fallback_if_no_other_claim",
    "credits":"revoke_remaining_and_record_consumed_debt",
    "partial":"freeze_source_and_require_review",
    "chargeback":"revoke_source_freeze_spending_alert_owner"
  },
  "admin_policy":{
    "owner_only":true,
    "aal2_required":true,
    "reason_required":true,
    "idempotency_required":true,
    "temporary_override_max_days":366,
    "private_content_visible":false,
    "audit_append_only":true
  },
  "release_gates":{
    "ledger_processing_enabled":false,
    "restore_enabled":false,
    "manual_adjustments_enabled":false,
    "test_catalog_provisioning_enabled":false,
    "test_checkout_enabled":false,
    "stripe_test_enabled":true,
    "google_play_sandbox_enabled":false,
    "apple_store_sandbox_enabled":false,
    "live_billing_enabled":false,
    "production_enabled":false
  }
}
