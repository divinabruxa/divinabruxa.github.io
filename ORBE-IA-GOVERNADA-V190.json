    "api": "Responses API",
    "application_state_stored": false,
    "web_search_enabled": false,
    "moderation_model": "omni-moderation-latest",
    "models": {
      "luna": "gpt-5.6-luna",
      "terra": "gpt-5.6-terra",
      "sol": null
