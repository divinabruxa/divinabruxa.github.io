  "privacy": {
    "browser_history_local_only": true,
    "server_conversation_history": false,
    "ledger_contains_conversation_text": false,
    "admin_receives_conversation_text": false,
    "analytics_receives_conversation_text": false,
    "diary_access": "one explicitly selected entry per consented request",
    "tarot_access": "one explicitly selected completed spread",
    "school_access": "one explicitly selected public lesson",
    "provider_request_store": false,
    "provider_training_default": "not used unless the API organization explicitly opts in",
    "provider_abuse_monitoring_standard_retention": "up to 30 days under current standard controls"
