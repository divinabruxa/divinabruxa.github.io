      { "credits": 600, "price_brl": 99.9 },
      { "credits": 1500, "price_brl": 199.9 }
    ]
  },
  "limits": {
    "per_user_requests_per_minute": 6,
    "per_user_daily_credits": 100,
    "global_daily_requests": 500,
    "global_daily_credits": 2000,
    "global_daily_cost_usd": 2.5,
    "max_input_characters": 5000,
    "max_history_messages": 12,
    "max_context_characters": 24000,
